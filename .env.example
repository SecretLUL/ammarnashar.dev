# Copy this file to .env and fill in your values. .env is git-ignored.
# docker compose reads it automatically, and so does `bun run dev`.

# Contact address on the page (mailto links and the copy button). server.ts fills it into the HTML
# while serving it, so the address never has to be written into the repository.
CONTACT_EMAIL=you@example.com

# Host address and port that docker compose publishes the site on. 127.0.0.1 keeps it reachable
# from this machine only; put a reverse proxy with HTTPS in front of it for the public site.
PORTFOLIO_BIND_IP=127.0.0.1
PORTFOLIO_PORT=3000
